# Copy to .env and edit. .env is gitignored: it is per-machine and holds a
# credential.
#
#   cp .env.example .env

# Required, and deliberately left empty: `cp .env.example .env` alone must not
# produce a working password. A value shipped here would be a known credential
# on every deployment that copied it — the same problem as admin/admin, but
# past the guard that catches admin/admin, because it is not that string.
#
# Compose refuses to run while this is empty.
SLUICE_ADMIN_PASSWORD=

# --- optional ---------------------------------------------------------------

# Published ports on the host. The container always listens on 8080/8443.
#SLUICE_HTTP_PORT=8080
#SLUICE_HTTPS_PORT=8443

# Where segments live. Default is a bind mount at ./data so growth is visible;
# store.cleanup defaults to "disabled", so this directory only grows. Set to a
# volume name to let the engine own it instead.
#DATA_MOUNT=./data

# Leave empty. Empty means the gateway emits relative URLs, which are correct at
# localhost, at a LAN address over TLS, and behind a proxy simultaneously. Only
# set it when a reverse proxy mounts the gateway under a sub-path.
#SLUICE_SERVER_BASE_URL=

# HTTPS with a self-signed certificate, needed to test DRM from another device:
# EME requires a secure context, and http://<LAN-IP> is not one, while
# http://localhost is. `make up-tls` fills SLUICE_TLS_IP in for you.
#SLUICE_TLS_SELF_SIGNED=true
#SLUICE_TLS_IP=192.0.2.10

# Run as a different uid. Needed on Docker for Linux, where a bind-mounted
# ./data belongs to your user and the image's 65532 cannot write to it. Not
# needed on Docker Desktop for macOS. `make up` sets this automatically.
#SLUICE_UID=1000
#SLUICE_GID=0

# Image to run. Point at GHCR to run a published build instead of a local one.
#SLUICE_IMAGE=ghcr.io/a840817a/sluice:latest
# Build the alpine variant with a shell instead of distroless.
#SLUICE_TARGET=debug
