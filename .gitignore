# Runtime segment cache and channel state (created by the gateway at startup).
/data/

# Local scratch: built binaries, ad-hoc configs, capture dumps.
/tmp/

# Real config carries admin credentials and upstream URLs; only the example
# belongs in the repo. The same applies to .env, which holds the container's
# admin password and host-specific values.
/config.yaml
/config.yml
/.env

# Compiled binaries
/gateway
/sluice
*.exe
*.test

# Test and profiling output
*.out
/coverage*

# Editor / OS noise
.DS_Store
.claude/settings.local.json
/.idea/
